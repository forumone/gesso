{
  "name": "gesso",
  "version": "5.4.3",
  "description": "Drupal starter theme",
  "type": "module",
  "main": "js/scripts.min.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "webpack --config ./webpack.theme-config.js --mode=development",
    "build": "webpack --config ./webpack.theme-config.js && webpack --config ./webpack.production.js && webpack --config ./webpack.react-config.js",
    "storybook": "storybook dev -p 6006",
    "watch-theme": "webpack watch --config ./webpack.dev.js",
    "watch-design-tokens": "webpack watch --config ./webpack.theme-config.js --mode=development",
    "watch-react": "webpack watch --config ./webpack.react-config.js",
    "watch": "npm run start && concurrently --raw \"npm:watch-theme\" \"npm:watch-design-tokens\" \"npm:watch-react\"",
    "eslint": "eslint source/**/!\\(*.stories\\).js",
    "stylelint": "stylelint \"source/**/*.scss\"",
    "build-storybook": "npm run build && storybook build -o storybook",
    "dev": "npm run start && concurrently --raw \"npm:watch-theme\" \"npm:watch-design-tokens\" \"npm:watch-react\" \"npm:storybook\"",
    "component": "node lib/component.js"
  },
  "author": "Forum One",
  "license": "GPL-2.0+",
  "browserslist": [
    "last 2 versions and not dead",
    ">= 1%",
    ">= 1% in US"
  ],
  "devDependencies": {
    "@forumone/eslint-config-es5": "^3.0.5",
    "@forumone/eslint-config-react": "^3.0.5",
    "@forumone/twig-drupal-filters": "^3.2.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@storybook/addon-a11y": "^10.0.3",
    "@storybook/addon-docs": "^10.0.3",
    "@storybook/addon-links": "^10.0.3",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/react-webpack5": "^10.0.3",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "core-js": "^3.46.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.0",
    "eslint-webpack-plugin": "^5.0.2",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.0.3",
    "inquirer": "^9.3.8",
    "js-yaml-loader": "^1.2.2",
    "mkdirp": "^3.0.1",
    "nani": "^3.2.3",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-selector-parser": "^7.1.0",
    "prettier": "^3.6.2",
    "react-refresh": "^0.17.0",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "stylelint": "^16.25.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-webpack-plugin": "^5.0.1",
    "svg-spritemap-webpack-plugin": "^5.0.3",
    "swc-loader": "^0.2.6",
    "ts-loader": "^9.5.4",
    "twig-loader": "https://github.com/fourkitchens/twig-loader/archive/6f04fedf24f13b69b62c457f971d80b06522ed34.tar.gz",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
