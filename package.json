{
  "name": "gesso",
  "version": "6.0.0",
  "description": "Drupal starter theme",
  "type": "module",
  "main": "js/scripts.min.js",
  "scripts": {
    "test": "npm run eslint && npm run eslint:lib && npm run typecheck:lib && npm run stylelint",
    "start": "webpack --config ./webpack.theme-config.js --mode=development",
    "build": "webpack --config ./webpack.theme-config.js && webpack --config ./webpack.production.js && webpack --config ./webpack.react-config.js",
    "storybook": "storybook dev -p 6006",
    "watch-theme": "webpack watch --config ./webpack.dev.js",
    "watch-design-tokens": "webpack watch --config ./webpack.theme-config.js --mode=development",
    "watch-react": "webpack watch --config ./webpack.react-config.js",
    "watch": "npm run start && concurrently --raw \"npm:watch-theme\" \"npm:watch-design-tokens\" \"npm:watch-react\"",
    "eslint": "eslint \"source/**/!(*.stories).{js,jsx,ts,tsx}\" \"components/**/!(*.stories).{js,jsx,ts,tsx}\"",
    "eslint:lib": "eslint \"lib/**/*.{js,ts}\"",
    "typecheck:lib": "tsc -p lib/tsconfig.json",
    "stylelint": "stylelint \"source/**/*.scss\" \"components/**/*.scss\"",
    "build-storybook": "npm run build && storybook build -o storybook",
    "dev": "npm run start && concurrently --raw \"npm:watch-theme\" \"npm:watch-design-tokens\" \"npm:watch-react\" \"npm:storybook\"",
    "component": "node lib/component-generator/component.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "pretest:e2e": "node lib/scripts/ensurePlaywrightBrowsers.js"
  },
  "author": "Forum One",
  "license": "GPL-2.0+",
  "engines": {
    "node": ">=24.15.0"
  },
  "browserslist": [
    "last 2 versions and not dead",
    ">= 1%",
    ">= 1% in US"
  ],
  "devDependencies": {
    "@forumone/eslint-config-es5": "^5.0.1",
    "@forumone/eslint-config-react": "^3.1.1",
    "@forumone/tiny-mustache": "^3.0.5",
    "@forumone/twig-drupal-filters": "^4.0.1",
    "@forumone/twig-loader": "^2.0.1",
    "@inquirer/prompts": "^8.7.5",
    "@playwright/test": "^1.65.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-webpack5": "^10.6.6",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/twig": "^1.12.17",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "autoprefixer": "^10.6.2",
    "chalk": "^6.0.1",
    "change-case": "^5.4.4",
    "concurrently": "^10.0.6",
    "core-js": "^3.51.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-webpack-plugin": "^6.0.0",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "html-react-parser": "^6.1.9",
    "js-yaml-loader": "^1.2.2",
    "jsdom": "^31.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "nani": "^3.2.3",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-refresh": "^0.19.0",
    "remove-files-webpack-plugin": "^1.5.0",
    "sass-embedded": "^1.107.1",
    "sass-loader": "^17.1.0",
    "storybook": "^10.6.6",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-prettier": "^5.0.3",
    "stylelint-webpack-plugin": "^5.1.0",
    "svg-spritemap-webpack-plugin": "^5.1.5",
    "svgo": "^4.1.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "twig": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-merge": "^6.0.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@drupal/once": "^1.0.1"
  },
  "overrides": {
    "storybook": "$storybook",
    "glob": "$glob"
  }
}
