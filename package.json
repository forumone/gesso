    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@drupal/once": "^1.0.1",
    "html-react-parser": "^5.2.7",
    "mini-css-extract-plugin": "^2.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remove-files-webpack-plugin": "^1.5.0",
    "sass-embedded": "^1.93.3",
    "storybook": "^10.0.3",
    "terser-webpack-plugin": "^5.3.14",
    "twig": "^1.17.1",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
