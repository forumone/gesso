import data from './{{ componentName }}.yml';
{{#modularSass}}
import './{{ componentName }}.scss';
{{/modularSass}}
{{#componentJs}}
import './{{ componentName }}';
{{/componentJs}}

const settings = {
  title: '{{#titleCase}}{{#cascadeLayer}}{{componentFolder}}{{/cascadeLayer}}{{/titleCase}}/{{ componentTitle }}'
};

