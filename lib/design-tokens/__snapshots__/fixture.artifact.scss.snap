// stylelint-disable
// DO NOT EDIT THIS FILE.  This is a gitignored artifact created by Webpack.
// Design tokens should be edited in source/00-config/config.design-tokens.yml
$gesso: (
  palette: (
    brand: (
      blue: (
        base: #0071BC,
        dark: #205493,
      ),
    ),
    grayscale: (
      white: #ffffff,
      black: #000000,
    ),
  ),
  colors: (
    text: (
      primary: #000000,
      link: #0071BC,
      on-dark: #ffffff,
      literal: 'quoted value',
      raw: color.get($foo, bar),
      mixed: map.get($palette, mixed),
    ),
  ),
  typography: (
    font-family: (
      primary: (
        name: Primary,
        stack: '"Source Sans Pro", Arial, sans-serif',
      ),
      system: (
        name: System,
        stack: $system-stack,
      ),
    ),
    base-font-size: 16px,
    font-size: (
      1: 12px,
      2: 14px,
    ),
    font-weight: (
      regular: 400,
      bold: 700,
    ),
    line-height: (
      base: 1.45,
    ),
    display: (
      h1: (
        color: #000000,
        font-family: '"Source Sans Pro", Arial, sans-serif',
        font-size: 14px,
        font-weight: 700,
        line-height: 1.45,
        responsive-font-size: 2,
        text-transform: uppercase,
      ),
      body: (
        color: #0071BC,
        font-family: $system-stack,
        font-weight: 400,
      ),
      cite: (
        color: color.get($foo, bar),
        font-family: '"Source Sans Pro", Arial, sans-serif',
        font-weight: 400,
      ),
    ),
  ),
  spacing: (
    0: 0,
    1: 8px,
    0.5: 4px,
  ),
  z-index: (
    nav: 1000,
  ),
  breakpoints: (
    tablet: 640px,
    wide: 'calc(100vw - 2rem)',
  ),
  flags: (
    enabled: true,
    disabled: false,
    nothing: null,
  ),
  transitions: (
    ease: 'cubic-bezier(0.4, 0, 0.2, 1)',
    shadow: '0 1px 3px rgb(0 0 0 / 12%)',
    var: var(--foo, 1px solid red),
  ),
);