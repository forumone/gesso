{#
/**
 * @file
 * Theme implementation to display a paragraph.
 */
#}

{% set section_content %}
  {% include 'gesso:grid' with {
    'num_of_cols': 3,
    'grid_content': content.field_cards|field_value
    }
  %}
{% endset %}

{% include 'gesso:section' with {
  'has_constrain': false,
  'section_title': null,
  'section_content': section_content,
} %}

{{ content|cache_metadata }}
