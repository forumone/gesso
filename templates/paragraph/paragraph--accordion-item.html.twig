{#
/**
 * @file
 * Theme implementation to display a paragraph.
 */
#}
{% include '@components/accordion/accordion-item.twig' with {
  'attributes': attributes,
  'modifier_classes': '',
  'title_element': 'h3',
  'title': content.field_title|field_value is not empty ? content.field_title|field_value : null,
  'content': content.field_wysiwyg|field_value is not empty ? content.field_wysiwyg|field_value : null,
} %}

{% set catch_cache = content|without('field_title', 'field_wysiwyg')|render %}
