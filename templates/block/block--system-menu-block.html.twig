{#
/**
 * @file
 * Theme implementation to display a block.
 */
#}
{% extends "block--admin.html.twig" %}

{% block block_content %}
  {% embed 'gesso:nav' with {
    'modifier_classes': 'l-nav--' ~ derivative_plugin_id|clean_class,
    'label': configuration.label,
    'nav_content': '',
  } %}

    {% block content %}
      {{ content }}
    {% endblock %}

  {% endembed %}
{% endblock %}
