{#
/**
 * @file
 * Theme implementation to display a block.
 */
#}
{% extends "block--admin.html.twig" %}

{% block block_content %}
  {% embed '@layouts/nav/nav.twig' with {
    'attributes' : '',
    'modifier_classes': 'l-nav--' ~ derivative_plugin_id|clean_class,
    'title_element': 'h2',
    'hide_title': (configuration.label_display == '0'),
    'title': configuration.label,
    'nav_id': 'nav-' ~ derivative_plugin_id|clean_id|unique_id,
  } %}

    {% block content %}
      {{ content }}
    {% endblock %}

  {% endembed %}
{% endblock %}
