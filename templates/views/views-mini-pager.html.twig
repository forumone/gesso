{#
/**
 * @file
 * Theme implementation for a views mini-pager.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - items: List of pager items.
 *
 * @see template_preprocess_views_mini_pager()
 */
#}
{% if items %}
  {% include 'gesso:pager-mini' with {
    'heading': 'Pagination'|t,
    'pager_items': items,
  } %}
{% endif %}
