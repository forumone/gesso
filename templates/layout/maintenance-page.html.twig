{#
/**
 * @file
 * Theme implementation for a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 */
#}
{% extends 'gesso:site-container' %}

{% block site_content %}
  {# page.header is missing system-branding-block. #}
  {% set header_content %}
    {% include '@gesso/block/block--system-branding-block.html.twig' %}
    {{ page.header }}
  {% endset %}

  {% if header_content|trim is not empty %}
    {% include 'gesso:header' with {
      'has_constrain': true,
      'header_content': header_content,
    } %}
  {% endif %}

  {% if page.navigation %}
    {% include 'gesso:region' with {
      'region_name': 'navigation',
      'has_constrain': true,
      'region_content': page.navigation,
    } %}
  {% endif %}

  {% if page.breadcrumb %}
    {% include 'gesso:breadcrumb-wrapper' with {
      'has_constrain': false,
      'breadcrumb_content': page.breadcrumb,
    } %}
  {% endif %}

  {% if page.help %}
    {% include 'gesso:region' with {
      'region_name': 'help',
      'has_constrain': true,
      'region_content': page.help,
    } %}
  {% endif %}

  <main id="main" class="main" role="main" tabindex="-1">
    {% if page.preface %}
      {% include 'gesso:region' with {
        'region_name': 'preface',
        'has_constrain': true,
        'region_content': page.preface,
      } %}
    {% endif %}

    {# page.content is missing page title. #}
    {% set content %}
      {{ page.title }}
      {{ page.status }}
      {{ page.content }}
    {% endset %}

    {% if content|trim is not empty %}
      {% include 'gesso:content' with {
        'has_constrain': true,
        'content_content': content,
      } %}
    {% endif %}

    {% if page.postscript %}
      {% include 'gesso:region' with {
        'region_name': 'postscript',
        'has_constrain': true,
        'region_content': page.postscript,
      } %}
    {% endif %}
  </main>

  {% if page.footer %}
    {% include 'gesso:footer' with {
      'has_constrain': true,
      'footer_content': page.footer,
    } %}
  {% endif %}
{% endblock %}
