{#
/**
 * @file
 * Theme implementation for a sidebar layout.
 */
#}
{% if content %}
  {% include '@layouts/sidebar/sidebar.twig' with {
    'attributes': attributes,
    'sidebar_header_content': content.header ?: null,
    'sidebar_first_content': content.sidebar_first ?: null,
    'sidebar_main_content': content.main ?: null,
    'sidebar_second_content': content.sidebar_second ?: null,
  } %}
{% endif %}

{{ content|cache_metadata }}
