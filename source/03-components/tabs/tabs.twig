{{ attach_library('gesso/tabs') }}
{% set unique_id = 'tabs'|clean_unique_id %}

{% set classes = [
  'c-tabs',
  modifier_classes ? modifier_classes : '',
] %}

<div {{ add_attributes({ class: classes }) }} data-display="{{ display }}">
  <div class="c-tabs__buttons" role="tablist">
    {% block tabs_buttons %}
      {% for tab in tabs %}
        <button
          class="c-tabs__button"
          type="button"
          role="tab"
          aria-controls="{{ unique_id ~ '-panel-' ~ loop.index }}"
        >
          {{ tab.label }}
        </button>
      {% endfor %}
    {% endblock %}
  </div>
  <div class="c-tabs__panels">
    {% block tabs_panels %}
      {% for tab in tabs %}
        <div
          class="c-tabs__panel"
          role="tabpanel"
          aria-hidden="true"
          id="{{ unique_id ~ '-panel-' ~ loop.index }}"
          tabindex="0"
        >
          {{ tab.content }}
        </div>
      {% endfor %}
    {% endblock %}
  </div>
</div>
