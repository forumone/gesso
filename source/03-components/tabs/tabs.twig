{{ attach_library('gesso/tabs') }}
{% set unique_id = 'tabs'|unique_id %}

{% set classes = [
  'c-tabs',
  modifier_classes ? modifier_classes : '',
] %}

<div {{ add_attributes({ class: classes }) }} data-display="{{ display|default('horizontal') }}">
  <div class="c-tabs__buttons" role="tablist">
    {% for tab_label in tab_labels %}
      <button
        class="c-tabs__button"
        type="button"
        role="tab"
        aria-controls="{{ unique_id ~ '-panel-' ~ loop.index }}"
      >
        {{ tab_label }}
      </button>
    {% endfor %}
  </div>
  <div class="c-tabs__panels">
    {% for tab_panel in tab_panels %}
      <div
        class="c-tabs__panel"
        role="tabpanel"
        aria-hidden="true"
        id="{{ unique_id ~ '-panel-' ~ loop.index }}"
        tabindex="0"
      >
        {{ tab_panel }}
      </div>
    {% endfor %}
  </div>
</div>

