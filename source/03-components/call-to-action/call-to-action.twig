{{ attach_library('gesso/call_to_action') }}

{% set classes = [
  'c-call-to-action',
  modifier_classes ? modifier_classes : ''
] %}

{% set cta_content %}
  <div class="c-call-to-action__media">
    {{ media }}
  </div>
  <div class="c-call-to-action__text">
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}
    {{ body }}
    {% if url and title %}
      <div>
        <a href="{{ url }}" class="c-button">{{ title }}</a>
      </div>
    {% endif %}
  </div>
{% endset %}

<div {{ add_attributes({ class: classes }) }}>
  {% include '@layouts/grid/grid.twig' with {
    'num_of_cols': '2',
    'grid_content': cta_content,
    'modifier_classes': 'c-call-to-action__grid',
  } %}
</div>
